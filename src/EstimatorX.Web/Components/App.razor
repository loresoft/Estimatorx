@inject IOptions<SeoOptions> SeoOptions

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="@SeoOptions.Value.Description" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="@SeoOptions.Value.CanonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SeoOptions.Value.SiteName" />
    <meta property="og:title" content="@SeoOptions.Value.SiteName" />
    <meta property="og:description" content="@SeoOptions.Value.Description" />
    <meta property="og:url" content="@SeoOptions.Value.CanonicalUrl" />
    <meta property="og:image" content="@ImageUrl" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@SeoOptions.Value.SiteName" />
    <meta name="twitter:description" content="@SeoOptions.Value.Description" />
    <meta name="twitter:image" content="@ImageUrl" />

    <meta name="theme-color" content="#ffffff" />

    <BasePath />

    <ResourcePreloader />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css"
          integrity="sha256-nKrJd6CvDCIpq9OX7uM0WJnEAg2ioaC3EcHMVD/jcZ0="
          crossorigin="anonymous">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css"
          integrity="sha256-ecmcGh4Ok3+AilgWVyi37QCADwLvXvz80Q3+cUZOZ10="
          crossorigin="anonymous">

    <link rel="stylesheet" href="@Assets["_content/LoreSoft.Blazor.Controls/BlazorControls.css"]" />
    <link rel="stylesheet" href="@Assets["EstimatorX.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["main.css"]" />

    <ImportMap />

    <meta name="apple-mobile-web-app-title" content="@SeoOptions.Value.SiteName" />

    <link rel="icon" type="image/png" href="@Assets["favicon-96x96.png"]" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="shortcut icon" href="@Assets["favicon.ico"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />

    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js"
            integrity="sha256-StKtMKffH6CmFcTP6xrv++kgGajf8CYsmUZKy9Vtylw="
            crossorigin="anonymous"></script>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveWebAssembly : null;

    private string ImageUrl => SeoOptions.Value.GetImageUrl(Assets);
}
