@inherits ModalComponentBase
@typeparam TItem where TItem : IHaveName
@using EstimatorX.Domain.Definitions

<ModalView Owner="this"
           Result="Items">
    <ul class="list-group reorder">
        @foreach (var item in Items)
        {
            <li @key="item"
                class="list-group-item list-group-item-action"
                draggable="true"
                title="@item.Name"
                @ondragstart="() => HandleDragStart(item)"
                @ondrop="(e) => HandleDrop(item)"
                @ondragover="(e) => HandleDragOver(item)"
                @ondrop:preventDefault
                @ondragover:preventDefault
                @ondragenter:preventDefault
                @ondragleave:preventDefault>
                <i class="bi bi-grip-vertical me-2"></i> @item.Name
            </li>
        }
    </ul>

    <p class="text-muted text-center p-1">
        Click and drag to reorder
    </p>
</ModalView>

@code {
    [Parameter, EditorRequired]
    public required List<TItem> Items { get; set; }

    private TItem? DragItem { get; set; }

    private void HandleDrop(TItem dropItem)
    {
        var dragItem = DragItem;
        DragItem = default;

        if (dragItem is null || EqualityComparer<TItem>.Default.Equals(dragItem, dropItem))
            return;

        var oldIndex = Items.IndexOf(dragItem);
        var newIndex = Items.IndexOf(dropItem);

        if (oldIndex < 0 || newIndex < 0)
            return;

        Items.RemoveAt(oldIndex);
        Items.Insert(newIndex, dragItem);

        StateHasChanged();
    }

    private void HandleDragStart(TItem item)
    {
        DragItem = item;
    }

    private void HandleDragOver(TItem item)
    {
        // need to allow drop on item, don't remove
    }
}
