@page "/not-found"
@layout MainLayout

<PageTitle>Not Found - EstimatorX</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-header bg-primary text-white">
                    <h1 class="h4 mb-0">Page Not Found</h1>
                </div>
                <div class="card-body p-5">
                    <div class="display-1 fw-bold text-primary mb-3">404</div>
                    <p class="lead mb-2">Sorry, the content you are looking for does not exist.</p>
                    <p class="text-muted mb-4">It may have been moved or deleted, or the address may be incorrect.</p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a href="@RouteLinks.Projects.List()" class="btn btn-outline-primary">Projects</a>
                        <a href="@RouteLinks.Templates.List()" class="btn btn-outline-primary">Templates</a>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@RouteLinks.Home()" class="text-decoration-none">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
