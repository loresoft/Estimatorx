@page "/projects/{id:long}/general"
@inherits ProjectBase
@attribute [Authorize]

<PageTitle>@PageTitle("General") - EstimatorX</PageTitle>

<Container Id="@Id"
           Title="@PageTitle("General")"
           Label="@EditLabel()">
    <LoadingBlock IsLoading="EditContext == null || Store.Model == null">
        <EditForm EditContext="EditContext"
                  OnValidSubmit="HandleSave">
            <FluentValidator />

            <div class="card-body">

                <div class="row">
                    <div class="col">
                        <ValidationSummary />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="Name" class="form-label">
                                Name: <span class="text-danger" title="Required Field">*</span>
                            </label>
                            <InputText DisplayName="Name"
                                       @bind-Value="Store.Model!.Name"
                                       id="Name"
                                       name="Name"
                                       class="form-control"
                                       placeholder="e.g. Customer Portal Redesign"
                                       aria-describedby="NameHelp" />
                            <ValidationMessage For="@(() => Store.Model.Name)" />
                            <div id="NameHelp" class="form-text">
                                A short, recognizable name shown in project lists and on the estimate report.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">
                                Description:
                            </label>
                            <InputTextArea DisplayName="Description"
                                           @bind-Value="Store.Model!.Description"
                                           id="Description"
                                           name="Description"
                                           class="form-control"
                                           rows="5"
                                           placeholder="Describe the goals and scope of the project"
                                           aria-describedby="DescriptionHelp" />
                            <ValidationMessage For="@(() => Store.Model.Description)" />
                            <div id="DescriptionHelp" class="form-text">
                                Summarize what the project delivers and what is in scope for this estimate.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="OrganizationId" class="form-label">
                                Organization:
                                <a class="mx-2"
                                   href="@RouteLinks.Organizations.List()"
                                   title="View Organization">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </label>
                            <EntitySelect TModel="OrganizationReadModel"
                                          TValue="long?"
                                          DisplayName="Organization"
                                          Placeholder="- private -"
                                          @bind-Value="Store.Model!.OrganizationId"
                                          id="OrganizationId"
                                          name="OrganizationId"
                                          class="form-select"
                                          aria-describedby="OrganizationIdHelp" />
                            <ValidationMessage For="@(() => Store.Model.OrganizationId)" />
                            <div id="OrganizationIdHelp" class="form-text">
                                Share with an organization, or leave <em>- private -</em> for only you.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="Assumptions" class="form-label">
                                Assumptions:
                            </label>
                            <InputTextArea DisplayName="Assumptions"
                                           @bind-Value="Store.Model!.Assumptions"
                                           id="Assumptions"
                                           name="Assumptions"
                                           class="form-control"
                                           rows="15"
                                           placeholder="e.g. Client provides test environments; existing APIs are documented"
                                           aria-describedby="AssumptionsHelp" />
                            <ValidationMessage For="@(() => Store.Model.Assumptions)" />
                            <div id="AssumptionsHelp" class="form-text">
                                List the project conditions the estimate depends on. These are included with the estimate so changes in scope or risk can be traced back to them.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <FormButtons Model="Model"
                         IsBusy="IsBusy"
                         IsClean="IsClean"
                         ShowDelete="!IsCreate"
                         OnDelete="HandleDelete" />
        </EditForm>
    </LoadingBlock>
</Container>

