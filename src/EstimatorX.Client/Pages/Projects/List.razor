@page "/projects"
@inherits ListPageBase<long, ProjectReadModel, ProjectListModel>
@attribute [Authorize]

<PageTitle>Projects - EstimatorX</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb d-print-none">
            <li class="breadcrumb-item">
                <a href="@RouteLinks.Home()">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Projects
            </li>
        </ol>
    </nav>
</div>
<div class="container-xxl">
    <div class="card shadow">
        <div class="card-header">
            <DataGridToolbar DataGrid="DataGrid"
                             ExportName="Projects"
                             Title="Projects">
                <FilterTemplate>
                    <div class="m-1 toolbar-control">
                        <EntityTypeahead TItem="OrganizationReadModel"
                                         TValue="long?"
                                         Sort="Name"
                                         Placeholder="Organization"
                                         MenuStyle="min-width:250px"
                                         @bind-Value="OrganizationId"
                                         @bind-Value:after="HandleOrganizationChange"
                                         style="min-width: 200px;" />
                    </div>
                </FilterTemplate>
                <ActionTemplate>
                    <a href="@RouteLinks.Projects.Create()"
                       title="Add Project"
                       class="btn btn-primary btn-sm mx-1">
                        Add
                    </a>
                </ActionTemplate>
            </DataGridToolbar>
        </div>

        <div class="card-body p-0">
            <DataGrid TItem="ProjectListModel"
                      DataProvider="LoadData"
                      Filterable="true"
                      Sortable="true"
                      @ref="DataComponent">
                <DataColumns>
                    <DataColumn Property="x => x.Id"
                                Width="150px"
                                Visible="false" />

                    <DataColumn Property="x => x.Name"
                                Title="Name"
                                Width="280px"
                                SortIndex="0">
                        <Template Context="item">
                            <a id="edit-link-@item.Id"
                               href="@RouteLinks.Projects.Summary(item.Id)"
                               class="d-block"
                               title="Edit Project">
                                @item.Name
                            </a>
                        </Template>
                    </DataColumn>

                    <DataColumn Property="x => x.Description"
                                Title="Description"
                                MinWidth="200px"
                                Visible="false" />

                    <DataColumn Property="x => x.OrganizationId"
                                Title="Organization Id"
                                Width="100px"
                                Align="TextAlign.Right"
                                Visible="false" />

                    <DataColumn Property="x => x.OrganizationName"
                                Title="Organization Name"
                                MinWidth="200px" />

                    <DataColumn Property="x => x.UserId"
                                Title="User Id"
                                Width="100px"
                                Align="TextAlign.Right"
                                Visible="false" />

                    <DataColumn Property="x => x.UserName"
                                Title="User Name"
                                Visible="false" />

                    <DataColumn Property="x => x.UserEmail"
                                Title="User Email"
                                Visible="false" />

                    <DataColumn Property="x => x.EstimatedTotal"
                                Title="Estimated"
                                Width="100px"
                                Align="TextAlign.Right" />

                    <DataColumn Property="x => x.WeightedTotal"
                                Title="Weighted"
                                Width="100px"
                                Align="TextAlign.Right" />

                    <DataColumn Property="x => x.EstimatedWeeks"
                                Title="Estimated Weeks"
                                HeaderTemplate="@SharedFragment.EstimatedWeeksHeader"
                                Width="110px"
                                Align="TextAlign.Right"
                                Format="N1" />

                    <DataColumn Property="x => x.WeightedWeeks"
                                Title="Weighted Weeks"
                                HeaderTemplate="@SharedFragment.WeightedWeeksHeader"
                                Width="110px"
                                Align="TextAlign.Right"
                                Format="N1" />

                    <DataColumn Property="x => x.EstimatedCost"
                                Title="Estimated Cost"
                                HeaderTemplate="@SharedFragment.EstimatedCostHeader"
                                Width="110px"
                                Align="TextAlign.Right"
                                Format="C"
                                Visible="false" />

                    <DataColumn Property="x => x.WeightedCost"
                                Title="Weighted Cost"
                                HeaderTemplate="@SharedFragment.WeightedCostHeader"
                                Width="110px"
                                Align="TextAlign.Right"
                                Format="C"
                                Visible="false" />

                    <DataColumn Property="x => x.CreatedBy"
                                Visible="false" />

                    <DataColumn Property="x => x.Created"
                                Width="160px"
                                Visible="false"
                                Format="g">
                        <Template Context="item">
                            <LocalTime Value="item.Created"
                                       DisplayFormat="g" />
                        </Template>
                    </DataColumn>

                    <DataColumn Property="x => x.UpdatedBy"
                                Visible="false" />

                    <DataColumn Property="x => x.Updated"
                                Width="160px"
                                Format="g">
                        <Template Context="item">
                            <LocalTime Value="item.Updated"
                                       DisplayFormat="g" />
                        </Template>
                    </DataColumn>

                    <DataColumn Property="x => x.Id"
                                Title="Action"
                                Filterable="false"
                                Sortable="false"
                                Hideable="false"
                                Width="100px">
                        <Template Context="item">
                            <div class="btn-actions btn-actions-sm" role="group" aria-label="Row Actions">
                                <a href="@RouteLinks.Projects.Summary(item.Id)"
                                   class="btn-action btn-action-primary"
                                   title="Edit Project">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <BusyButton Trigger="() => HandleDelete(item)"
                                            BusyText="..."
                                            type="button"
                                            class="btn-action btn-action-danger"
                                            title="Delete Project">
                                    <i class="bi bi-trash3"></i>
                                </BusyButton>
                            </div>
                        </Template>
                    </DataColumn>
                </DataColumns>
                <DataPagination Context="grid">
                    <DataPager PageSize="10" class="mx-2" />
                    <DataSizer />
                    <div class="mx-2">@grid.Pager.StartItem - @grid.Pager.EndItem of @grid.Pager.Total</div>
                </DataPagination>
            </DataGrid>
        </div>

        <div class="card-footer">
            <a class="btn btn-primary"
               title="Add Project"
               href="@RouteLinks.Projects.Create()">
                Add Project
            </a>
        </div>
    </div>
</div>

@code
{
    private long? OrganizationId { get; set; }

    private async Task HandleOrganizationChange()
    {
        if (DataGrid == null)
            return;

        var filterName = nameof(HandleOrganizationChange);

        if (!OrganizationId.HasValue)
        {
            await DataGrid.RemoveFilter(filterName);
            return;
        }

        var filter = new QueryFilter
        {
            Id = filterName,
            Field = nameof(ProjectListModel.OrganizationId),
            Operator = QueryOperators.Equal,
            Value = OrganizationId.Value
        };

        await DataGrid.ApplyFilter(filter);
    }
}

