@page "/projects/{id:long}/settings"
@inherits ProjectBase
@attribute [Authorize]

<PageTitle>@PageTitle("Settings") - EstimatorX</PageTitle>

<Container Id="@Id"
           Title="@PageTitle("Settings")"
           Label="@EditLabel()">
    <LoadingBlock IsLoading="EditContext == null || Store.Model == null">
        <EditForm EditContext="EditContext"
                  OnValidSubmit="HandleSave">

            <FluentValidator />

            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <ValidationSummary />
                    </div>
                </div>

                <!-- Settings Editor -->
                <SettingEditor ProjectSettings="@ProjectSettings"
                               NotifyStateChanged="Store.NotifyStateChanged" />

            </div>

            <FormButtons Model="Model"
                         IsBusy="IsBusy"
                         IsClean="IsClean"
                         ShowDelete="!IsCreate"
                         OnDelete="HandleDelete" />
        </EditForm>
    </LoadingBlock>
</Container>

