@page "/projects/{id:long}/estimation"
@inherits ProjectBase
@attribute [Authorize]

<PageTitle>@PageTitle("Estimation") - EstimatorX</PageTitle>

<Container Id="@Id"
           Title="@PageTitle("Estimation")"
           Label="@EditLabel()">
    <LoadingBlock IsLoading="EditContext == null || Store.Model == null">
        <EditForm EditContext="EditContext"
                  OnValidSubmit="HandleSave">
            <FluentValidator />
            <div class="card-body p-0">
                <div class="row">
                    <div class="col">
                        <ValidationSummary />
                    </div>
                </div>
                <!-- Estimation Editor -->
                <EstimationEditor Model="@Model"
                                  NotifyStateChanged="Store.NotifyStateChanged" />
            </div>
            <FormButtons Model="Model"
                         IsBusy="IsBusy"
                         IsClean="IsClean"
                         ShowDelete="!IsCreate"
                         OnDelete="HandleDelete" />
        </EditForm>
    </LoadingBlock>
</Container>

