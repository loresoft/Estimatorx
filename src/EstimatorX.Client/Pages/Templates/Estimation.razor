@page "/templates/{id:long}/estimation"
@inherits TemplateBase
@attribute [Authorize]

<PageTitle>@PageTitle("Estimation") - EstimatorX</PageTitle>

<Container Id="@Id"
           Title="@PageTitle("Estimation")"
           Label="@EditLabel()">
    <LoadingBlock IsLoading="EditContext == null || Store.Model == null">
        <EditForm EditContext="EditContext"
                  OnValidSubmit="HandleSave">
            <FluentValidator />
            <div class="card-body p-0">
                <div class="row">
                    <div class="col">
                        <ValidationSummary />
                    </div>
                </div>
                <!-- Estimation Editor -->
                <EstimationEditor Model="@Model"
                                  NotifyStateChanged="Store.NotifyStateChanged" />
            </div>
            <div class="card-footer">
                <!-- Form Buttons -->
                <div class="row">
                    <div class="col-sm-6">
                        <BusyButton id="save-button"
                                    type="submit"
                                    Busy="Store.IsBusy"
                                    Disabled="Store.IsClean"
                                    class="btn btn-primary">
                            Save
                        </BusyButton>
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        @if (!IsCreate)
                        {
                            <BusyButton id="delete-button"
                                        type="button"
                                        Trigger="HandleDelete"
                                        Disabled="@Store.IsBusy"
                                        class="btn btn-danger">
                                Delete
                            </BusyButton>
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    </LoadingBlock>
</Container>

